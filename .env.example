# Copier ce fichier en .env et choisir des mots de passe (le fichier .env n'est jamais versionné).
SARF_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Mot de passe des comptes de démonstration (admin.sarf, ordonnateur.amal, comptable.karim,
# fournisseur.atlas, auditeur.salma). Keycloak exige au moins 12 caractères.
SARF_DEMO_PASSWORD=
